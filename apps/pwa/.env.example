# API transport: mock = MSW + typed fixtures (issue #9), live = real backend
VITE_API_MODE=mock
# live mode: vite proxies /api → 127.0.0.1:8081 (cmd/server)
#   docker compose up -d postgres redis
#   OPENGLASS_DEV_MODE=1 go run ./cmd/server
# VITE_API_MODE=live

# pwa-dev demo host only — includes the private remote module in the bundle.
# MUST stay unset/0 for the production pwa-mvp build. Use the dedicated
# scripts instead of hand-setting: `pnpm dev:private` / `pnpm build:dev-host`
# (mode pwa-dev loads .env.pwa-dev). After a production `pnpm build`,
# `pnpm verify:mvp-bundle` asserts dist/ contains no private artifacts.
# VITE_PRIVATE_MODULE=1
